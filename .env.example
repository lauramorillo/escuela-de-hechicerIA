# Google Cloud / Vertex AI (Agent Platform)
GOOGLE_CLOUD_PROJECT="MY_PROJECT"
GOOGLE_CLOUD_LOCATION="europe-west1"

# GEMINI_API_KEY: Solo si usas Google AI Studio o Vertex Express Mode
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_EVALUATION_SERVICE_URL: URL pública del microservicio evaluador de profesores (Cloud Run)
VITE_EVALUATION_SERVICE_URL="http://localhost:8080"
